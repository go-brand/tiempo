{
  "name": "@gobrand/tiempo",
  "version": "3.3.0",
  "private": false,
  "description": "date-fns-style functions for the Temporal API: timezone conversion, DST-safe date math, formatting, parsing, and business days, in TypeScript",
  "keywords": [
    "business-days",
    "date",
    "date-fns",
    "datetime",
    "dayjs",
    "daylight-saving-time",
    "dst",
    "format",
    "iana",
    "moment",
    "parse",
    "plain-date",
    "temporal",
    "temporal-api",
    "temporal-polyfill",
    "time",
    "time-zone",
    "timezone",
    "typescript",
    "utc",
    "zoned-datetime"
  ],
  "homepage": "https://tiempo.gobrand.app",
  "bugs": {
    "url": "https://github.com/go-brand/tiempo/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/go-brand/tiempo.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/index.d.ts",
      "default": "./dist/native/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:timezones": "node scripts/generate-timezone-types.ts",
    "generate:matrix": "node scripts/generate-capability-matrix.ts",
    "generate:docs": "node scripts/generate-docs.ts",
    "build": "pnpm generate:timezones && pnpm generate:matrix && pnpm generate:docs && node scripts/build.ts && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/fix-declaration-imports.ts && pnpm smoke:package",
    "clean": "git clean -xdf .cache .turbo dist node_modules tsconfig.tsbuildinfo",
    "smoke:package": "tsc -p smoke/tsconfig.json && node smoke/consumer.ts",
    "test": "vitest",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "release": "bash scripts/release.sh",
    "version": "node scripts/sync-jsr-version.mjs && git add jsr.json",
    "smoke:tarball": "node scripts/smoke-tarball.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "devDependencies": {
    "@types/node": "22.19.6",
    "esbuild": "0.27.2",
    "jsr": "0.14.3",
    "oxfmt": "0.78.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4"
}
