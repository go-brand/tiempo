{
  "name": "@gobrand/tiempo",
  "version": "3.0.1",
  "description": "Lightweight timezone-safe date and time utilities built on the Temporal API",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/go-brand/tiempo.git"
  },
  "bugs": {
    "url": "https://github.com/go-brand/tiempo/issues"
  },
  "homepage": "https://tiempo.gobrand.app",
  "scripts": {
    "generate:timezones": "tsx scripts/generate-timezone-types.ts",
    "generate:matrix": "tsx scripts/generate-capability-matrix.ts",
    "generate:docs": "tsx scripts/generate-docs.ts",
    "build": "pnpm generate:timezones && pnpm generate:matrix && pnpm generate:docs && tsup && tsc -p tsconfig.build.json --emitDeclarationOnly && tsx scripts/fix-declaration-imports.ts && pnpm smoke:package",
    "clean": "git clean -xdf .cache .turbo dist node_modules tsconfig.tsbuildinfo",
    "smoke:package": "tsc -p smoke/tsconfig.json && tsx smoke/consumer.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "temporal",
    "timezone",
    "utc",
    "datetime",
    "zoned-datetime",
    "time-conversion"
  ]
}
